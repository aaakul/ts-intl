{
  "name": "@aaakul/ts-intl-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebench": "playwright install --only-shell chromium",
    "bench": "node --experimental-strip-types ./bench.ts",
    "build": "node --experimental-strip-types ./build.ts --run",
    "preview": "node --experimental-strip-types ./server.ts --preview",
    "clean": "node -e \"import('fs').then(fs => { fs.rmSync('./dist', { recursive: true, force: true }); fs.rmSync('./src/paraglide', { recursive: true, force: true }); fs.rmSync('./messages', { recursive: true, force: true }); fs.rmSync('./project.inlang', { recursive: true, force: true }); })\""
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@inlang/paraglide-js": "^2.25.4",
    "hono": "^4.6.11",
    "playwright": "^1.50.1",
    "typescript": "^5.8.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@aaakul/ts-intl": "workspace:*",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-backend": "^3.0.2"
  }
}
