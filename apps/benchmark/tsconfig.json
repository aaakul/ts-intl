{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false
  },
  "include": [
    "./src",
    "./build.ts",
    "./bench.ts",
    "./server.ts",
    "./build.config.ts",
    "./build.samples.ts"
  ],
  "exclude": ["./src/pages/**/*", "dist"]
}
