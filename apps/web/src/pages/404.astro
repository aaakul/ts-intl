---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout
  title="404 - Page Not Found"
  description="The requested page could not be found."
  lang="en-US"
  canonicalPath="/404"
  noindex={true}
>
  <Navbar lang="en-US" isDocsPage={false} />

  <main
    class="min-h-[calc(100vh-14rem)] flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-16 text-center"
  >
    <div
      class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium border border-neutral-200 dark:border-neutral-800 bg-neutral-100/60 dark:bg-neutral-900/60 text-neutral-600 dark:text-neutral-400 mb-6"
    >
      Error 404
    </div>

    <h1
      class="text-3xl sm:text-5xl font-bold tracking-tight text-neutral-950 dark:text-white mb-4"
    >
      Page Not Found
    </h1>

    <p
      class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-md mx-auto mb-8 leading-relaxed"
    >
      Sorry, we couldn't find the page you're looking for. It might have been
      moved or doesn't exist.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        id="home-link"
        href="/en-US"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-md text-xs font-medium text-white dark:text-neutral-950 bg-neutral-950 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors"
      >
        Go back home
      </a>

      <a
        id="docs-link"
        href="/en-US/docs/overview-and-installation"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-md text-xs font-medium text-neutral-800 dark:text-neutral-200 border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors"
      >
        Read documentation
      </a>
    </div>
  </main>

  <Footer lang="en-US" />

  <!-- Smart locale adjustment based on previous browser path or language -->
  <script is:inline>
    (function () {
      try {
        const path = window.location.pathname;
        let lang = "en-US";
        if (
          path.startsWith("/zh-Hans") ||
          navigator.language.toLowerCase().startsWith("zh")
        ) {
          lang = "zh-Hans";
        } else if (
          path.startsWith("/ja-JP") ||
          navigator.language.toLowerCase().startsWith("ja")
        ) {
          lang = "ja-JP";
        }

        if (lang !== "en-US") {
          const homeLink = document.getElementById("home-link");
          const docsLink = document.getElementById("docs-link");
          if (homeLink) homeLink.setAttribute("href", "/" + lang);
          if (docsLink)
            docsLink.setAttribute(
              "href",
              "/" + lang + "/docs/overview-and-installation",
            );
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
