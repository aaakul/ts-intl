---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import Features from "@/components/Features.astro";
import BenchmarkSection from "@/components/BenchmarkSection.astro";
import Footer from "@/components/Footer.astro";
import { languages, type SupportedLanguage, useTranslations } from "@/i18n";

import { SITE_CONFIG } from "@/config/site";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const tHero = useTranslations("hero");
const tFooter = useTranslations("footer");

const siteBase = Astro.site ?? SITE_CONFIG.url;
const homeUrl = new URL(`/${lang}`, siteBase).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${new URL("/", siteBase).href}#website`,
      url: new URL("/", siteBase).href,
      name: SITE_CONFIG.name,
      description: tFooter("tagline"),
      inLanguage: lang,
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${homeUrl}#software`,
      name: "ts-intl",
      programmingLanguage: "TypeScript",
      codeRepository: SITE_CONFIG.githubUrl,
      runtimePlatform: ["Node.js", "Browser", "Astro", "Bun"],
      license: "https://opensource.org/licenses/MIT",
      description: tFooter("tagline"),
    },
  ],
};
---

<BaseLayout
  title={`ts-intl | ${tHero("title")}`}
  description={tFooter("tagline")}
  lang={lang}
  canonicalPath=""
  jsonLd={jsonLd}
>
  <Navbar lang={lang} isDocsPage={false} />
  <main>
    <Hero />
    <Features lang={lang} />
    <BenchmarkSection lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
