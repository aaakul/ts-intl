---
import { languages, type SupportedLanguage } from "@/i18n";
import { SITE_CONFIG } from "@/config/site";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const targetUrl = `/${lang}/docs/overview-and-installation`;
const canonicalUrl = new URL(targetUrl, Astro.site ?? SITE_CONFIG.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Documentation...</title>
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={canonicalUrl} />
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <style>
    :root {
      color-scheme: light dark;
    }
    body {
      margin: 0;
      background-color: Canvas;
      color: CanvasText;
    }
  </style>
  <body></body>
</html>
