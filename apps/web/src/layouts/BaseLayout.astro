---
import type { SupportedLanguage } from "@/i18n";
import { languages } from "@/i18n";
import { SITE_CONFIG } from "@/config/site";

interface Props {
  title: string;
  description?: string;
  lang: SupportedLanguage;
  canonicalPath?: string;
}

const {
  title,
  description = "A zero-dependency, framework-agnostic, strictly type-safe i18n library with a developer experience inspired by next-intl.",
  lang,
  canonicalPath = "",
} = Astro.props;

const siteBase = Astro.site ?? SITE_CONFIG.url;
const fullTitle = title.includes("ts-intl") ? title : `${title} | ts-intl`;
const canonicalUrl = new URL(`/${lang}${canonicalPath}`, siteBase).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="apple-touch-icon"
      type="image/png"
      href="/apple-touch-icon.png"
      sizes="180x180"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Multilingual Alternate Hreflang -->
    {
      languages.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(`/${l}${canonicalPath}`, siteBase).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/en-US${canonicalPath}`, siteBase).href}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function () {
        var stored =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        var theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 font-sans antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800"
  >
    <slot />

    <!-- Lightweight Zero-Dependency Copy Code Handler -->
    <script is:inline>
      function setupCodeCopyButtons() {
        const preElements = document.querySelectorAll("pre");
        preElements.forEach((pre) => {
          if (pre.querySelector(".copy-code-btn")) return;
          const button = document.createElement("button");
          button.className = "copy-code-btn";
          button.type = "button";
          button.setAttribute("aria-label", "Copy code");
          button.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>';
          button.onclick = async () => {
            const code = pre.querySelector("code")?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code.trim());
              button.innerHTML =
                '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
              button.classList.add("copied");
              setTimeout(() => {
                button.innerHTML =
                  '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>';
                button.classList.remove("copied");
              }, 2000);
            } catch (err) {
              console.error("Failed to copy code: ", err);
            }
          };
          pre.appendChild(button);
        });
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupCodeCopyButtons);
      } else {
        setupCodeCopyButtons();
      }
      document.addEventListener("astro:after-swap", setupCodeCopyButtons);
    </script>
  </body>
</html>

<style is:global>
  pre {
    position: relative;
    border: 1px solid #e5e5e5;
    border-radius: 0.5rem;
    padding: 1rem;
    font-family:
      "JetBrains Mono", Menlo, Monaco, Consolas, "Liberation Mono",
      "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", "Noto Sans SC",
      "WenQuanYi Micro Hei", sans-serif;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .dark pre {
    border-color: #262626;
  }

  /* Copy Code Button */
  .copy-code-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: 0.375rem;
    border: 1px solid #e5e5e5;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px);
    color: #737373;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
    z-index: 10;
  }

  .dark .copy-code-btn {
    border-color: #333333;
    background-color: rgba(23, 23, 23, 0.85);
    color: #a3a3a3;
  }

  pre:hover .copy-code-btn,
  .copy-code-btn:focus,
  .copy-code-btn.copied {
    opacity: 1;
  }

  @media (pointer: coarse) {
    .copy-code-btn {
      opacity: 0.7;
    }
  }

  .copy-code-btn:hover {
    color: #171717;
    background-color: #f0f0f0;
  }

  .dark .copy-code-btn:hover {
    color: #fff;
    background-color: #262626;
  }

  /* Shiki dual-theme dark mode support */
  html.dark .astro-code-themes,
  html.dark .astro-code-themes span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  code {
    font-family:
      "JetBrains Mono", Menlo, Monaco, Consolas, "Liberation Mono",
      "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", "Noto Sans SC",
      "WenQuanYi Micro Hei", sans-serif;
  }

  :not(pre) > code {
    padding: 0.15rem 0.35rem;
    font-size: 0.8125rem;
    border-radius: 0.25rem;
    background-color: #f5f5f5;
    border: 1px solid #e5e5e5;
  }

  .dark :not(pre) > code {
    background-color: rgba(38, 38, 38, 0.5);
    border-color: #262626;
  }
</style>
