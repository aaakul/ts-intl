---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import Icon from "./Icon.astro";
import { SITE_CONFIG } from "@/config/site";
import { getTranslations, type SupportedLanguage } from "@/i18n";

interface Props {
  lang: SupportedLanguage;
  currentSlug?: string;
  isDocsPage?: boolean;
}

const { lang, currentSlug = "", isDocsPage = false } = Astro.props;
const t = getTranslations(lang, "nav");
---

<header
  class="sticky top-0 z-40 w-full border-b border-neutral-200 dark:border-neutral-800 bg-white/90 dark:bg-neutral-950/90 backdrop-blur-md"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between"
  >
    <!-- Left: Brand -->
    <a
      href={`/${lang}`}
      class="font-bold font-mono tracking-tight text-neutral-900 dark:text-white hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors"
    >
      ts-intl
    </a>

    <!-- Right: Navigation & Actions -->
    <div class="flex items-center gap-4">
      <nav
        aria-label="Main Navigation"
        class="hidden md:flex items-center gap-5 text-xs font-medium text-neutral-600 dark:text-neutral-400"
      >
        <a
          href={`/${lang}/docs/overview-and-installation`}
          aria-current={isDocsPage ? "page" : undefined}
          class={`hover:text-neutral-950 dark:hover:text-white transition-colors ${
            isDocsPage ? "text-neutral-950 dark:text-white font-semibold" : ""
          }`}
        >
          {t("docs")}
        </a>
        <a
          href={SITE_CONFIG.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 hover:text-neutral-950 dark:hover:text-white transition-colors"
        >
          <span>{t("github")}</span>
          <Icon name="external-link" class="w-3 h-3 text-neutral-400" />
        </a>
      </nav>

      <div class="h-4 w-px bg-neutral-200 dark:bg-neutral-800 hidden md:block">
      </div>

      <!-- Language Selector -->
      <LanguageSelector
        lang={lang}
        currentSlug={currentSlug}
        isDocsPage={isDocsPage}
      />

      <!-- Theme Switcher -->
      <ThemeToggle label={t("themeToggle")} />

      <!-- Mobile GitHub Link -->
      <a
        href={SITE_CONFIG.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="md:hidden p-2 rounded-md border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
        aria-label={t("github")}
      >
        <Icon name="github" class="w-4 h-4" />
      </a>

      <!-- Mobile Docs Link (shown when not already on docs page) -->
      {
        !isDocsPage && (
          <a
            href={`/${lang}/docs/overview-and-installation`}
            class="md:hidden px-2.5 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800 text-xs font-medium text-neutral-800 dark:text-neutral-200"
          >
            {t("docs")}
          </a>
        )
      }
    </div>
  </div>
</header>
