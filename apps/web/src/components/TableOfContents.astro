---
import type { SupportedLanguage } from "@/i18n";
import { getTranslations } from "@/i18n";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: SupportedLanguage;
}

const { headings, lang } = Astro.props;
const t = getTranslations(lang, "docs");

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length > 0 && (
    <nav class="hidden xl:block w-56 shrink-0 sticky top-20 self-start max-h-[calc(100vh-6rem)] overflow-y-auto pl-6 text-xs border-l border-neutral-200/80 dark:border-neutral-800/80">
      <div class="text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold mb-3">
        {t("onThisPage")}
      </div>
      <ul class="space-y-2">
        {filteredHeadings.map((h) => (
          <li class={h.depth === 3 ? "pl-3" : ""}>
            <a
              href={`#${h.slug}`}
              class="block text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors truncate"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
