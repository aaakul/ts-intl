---
import { getTranslations, type SupportedLanguage } from "@/i18n";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "features");

interface FeatureItem {
  icon: IconName;
  title: string;
  desc: string;
}

const gzSize = "5";

const features: FeatureItem[] = [
  {
    icon: "shield-check",
    title: t("typeSafetyTitle"),
    desc: t("typeSafetyDesc"),
  },
  {
    icon: "package",
    title: t("zeroDepTitle"),
    desc: `${t("zeroDepDesc")} Minified + Gzipped: < ${gzSize} kB `,
  },
  {
    icon: "languages",
    title: t("icuTitle"),
    desc: t("icuDesc"),
  },
  {
    icon: "monitor",
    title: t("frameworkTitle"),
    desc: t("frameworkDesc"),
  },
];
---

<section class="py-16 md:py-20 bg-neutral-50/50 dark:bg-neutral-950/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        features.map((feature, index) => (
          <div
            class="animate-fade-in-up p-6 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xs"
            style={`animation-delay: ${index * 80}ms;`}
          >
            <div class="w-8 h-8 rounded border border-neutral-200 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-900 dark:text-white mb-4">
              <Icon name={feature.icon} class="w-4 h-4" />
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">
              {feature.title}
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {feature.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
