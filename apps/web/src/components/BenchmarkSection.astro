---
import { getTranslations, type SupportedLanguage } from "@/i18n";
import BenchmarkChart from "./BenchmarkChart.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = getTranslations(lang, "benchmark");
---

<section
  class="py-16 md:py-24 border-t border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-950/40"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-12">
      <div
        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700/60 mb-3"
      >
        {t("badge")}
      </div>
      <h2
        class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white mb-3"
      >
        {t("title")}
      </h2>
      <p
        class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed"
      >
        {t("desc")}
      </p>
    </div>

    <!-- 2D Bar Chart Component -->
    <div class="max-w-3xl mx-auto mb-8">
      <BenchmarkChart lang={lang} />
    </div>

    <!-- Takeaways Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto mb-8">
      <div
        class="p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xs"
      >
        <div
          class="flex items-center gap-2 text-neutral-900 dark:text-white font-semibold text-xs mb-1.5"
        >
          <Icon
            name="shield-check"
            class="w-4 h-4 text-neutral-500 dark:text-neutral-400"
          />
          <span>{t("takeaway1Title")}</span>
        </div>
        <p
          class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed"
        >
          {t("takeaway1Desc")}
        </p>
      </div>

      <div
        class="p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xs"
      >
        <div
          class="flex items-center gap-2 text-neutral-900 dark:text-white font-semibold text-xs mb-1.5"
        >
          <Icon
            name="package"
            class="w-4 h-4 text-neutral-500 dark:text-neutral-400"
          />
          <span>{t("takeaway2Title")}</span>
        </div>
        <p
          class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed"
        >
          {t("takeaway2Desc")}
        </p>
      </div>
    </div>

    <!-- Link to Full Docs -->
    <div class="text-center">
      <a
        href={`/${lang}/docs/benchmark`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 dark:bg-white dark:hover:bg-neutral-100 text-white dark:text-neutral-900 transition-colors shadow-xs"
      >
        <span>{t("viewFullDocs")}</span>
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
