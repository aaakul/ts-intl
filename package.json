{
  "name": "ts-intl-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm --filter \"@aaakul/ts-intl\" build && pnpm --filter web build",
    "build:lib": "pnpm --filter \"@aaakul/ts-intl\" build",
    "build:web": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "dev:lib": "pnpm --filter \"@aaakul/ts-intl\" dev",
    "test": "pnpm --filter \"@aaakul/ts-intl\" test",
    "test:watch": "pnpm --filter \"@aaakul/ts-intl\" test:watch",
    "typecheck": "pnpm --filter \"@aaakul/ts-intl\" typecheck && pnpm --filter web check",
    "check": "pnpm --filter \"@aaakul/ts-intl\" check"
  }
}
